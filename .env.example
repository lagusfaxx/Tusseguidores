# --- Sitio -------------------------------------------------------------------
# URL pública con https y sin barra final. Se usa en los enlaces canónicos,
# el sitemap y las URL de retorno de Flow.
SITE_URL=https://tusseguidores.cl

# Dónde viven la base de datos SQLite y las fotos subidas desde el panel.
# En Docker apunta al volumen persistente.
DATA_DIR=/app/data
# DATABASE_PATH=/app/data/tusseguidores.db

# --- Usuario del panel (solo se usa en el primer arranque) --------------------
ADMIN_EMAIL=admin@tusseguidores.cl
ADMIN_PASSWORD=cambia-esta-contrasena

# --- Proveedor (honestsmm) ---------------------------------------------------
# Opcional: si la defines aquí, tiene prioridad sobre la guardada en el panel.
PROVIDER_API_KEY=

# --- Pagos (Flow.cl) ---------------------------------------------------------
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Entorno de cobro: 1 = sandbox.flow.cl (pruebas), 0 = www.flow.cl (real).
#
# DÉJALA VACÍA para manejarlo desde el panel. Si le pones un valor, la casilla
# "Modo de pruebas" de /admin/ajustes deja de tener efecto y no queda claro por
# qué el sitio sigue cobrando en pruebas.
#
# Las credenciales de pruebas y las de producción son DISTINTAS: usar unas con
# el otro entorno hace que Flow responda "apiKey not found".
FLOW_SANDBOX=

# Solo para pruebas locales: reemplaza la URL del entorno sandbox.
# Déjalo vacío en producción.
# FLOW_SANDBOX_URL=

# --- Cron --------------------------------------------------------------------
# Clave para llamar a /api/cron/sincronizar y actualizar el estado de los pedidos.
CRON_SECRET=

# Pon 1 para reimportar el catálogo del proveedor en cada arranque.
SEED_ON_START=0
